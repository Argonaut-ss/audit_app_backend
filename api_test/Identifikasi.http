@baseUrl = http://localhost:8000/api
@contentType = application/json
@adminToken = {{adminLogin.response.body.token}}
@mahasiswaToken = {{mhsLogin.response.body.token}}
@dosenToken = {{dosenLogin.response.body.token}}


# Health Check (no Auth)
GET {{baseUrl}}/health

### Login - Admin
# @name adminLogin
POST {{baseUrl}}/login
Content-Type: {{contentType}}

{
  "email": "admin@binus.ac.id",
  "password": "Admin123"
}

### Login - Mahasiswa
# @name mhsLogin
POST {{baseUrl}}/login
Content-Type: {{contentType}}

{
  "email": "adrian.ananta@binus.ac.id",
  "password": "Adrian123"
}

### Login - Dosen
# @name dosenLogin
POST {{baseUrl}}/login
Content-Type: {{contentType}}

{
  "email": "wono.jair@binus.edu",
  "password": "Wono123"
}

### Get Identifikasi by ID
GET {{baseUrl}}/identifikasi/1
Authorization: Bearer {{adminToken}}
Accept: application/json

### Update Identifikasi
PUT {{baseUrl}}/identifikasi/1
Authorization: Bearer {{adminToken}}
Accept: application/json
Content-Type: application/json

