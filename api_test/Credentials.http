@baseUrl = http://localhost:8000/api
@contentType = application/json

@adminToken = {{adminLogin.response.body.token}}
@mahasiswaToken = {{mhsLogin.response.body.token}}
@dosenToken = {{dosenLogin.response.body.token}}

# Health Check
GET {{baseUrl}}/health

### Login - Admin
# @name adminLogin
POST {{baseUrl}}/login
Content-Type: {{contentType}}

{
  "email": "admin@binus.ac.id",
  "password": "Admin123"
}

### Login - Mahasiswa
# @name mhsLogin
POST {{baseUrl}}/login
Content-Type: {{contentType}}

{
  "email": "adrian.ananta@binus.ac.id",
  "password": "Adrian123"
}

### Login - Dosen
# @name dosenLogin
POST {{baseUrl}}/login
Content-Type: {{contentType}}

{
  "email": "wono.jair@binus.edu",
  "password": "Wono123"
}

### Me endpoint untuk verifikasi token dan role
# Ganti token di header Authorization sesuai role yang ingin diuji
GET {{baseUrl}}/me
Authorization: Bearer {{mahasiswaToken}}

### Test Login & Token
# a. Login dengan password salah 
# → 401, karena password salah
POST {{baseUrl}}/login
Content-Type: {{contentType}}

{
  "email": "admin@binus.ac.id",
  "password": "wrongpassword"
}

### b. Login dengan email tidak valid
# → 401, karena email tidak ditemukan di database
POST {{baseUrl}}/login
Content-Type: {{contentType}}

{
  "email": "nobody@exists.com",
  "password": "password"
}

### c. Akses protected endpoint
# → 401, karena tidak mengirim token di header Authorization/token salah
GET {{baseUrl}}/kelas
# Authorization: Bearer invalidtoken123
# Uncomment bila ingin test invalid token

### Logout endpoint untuk revoke token
# a. Logout admin
POST {{baseUrl}}/logout
Authorization: Bearer {{adminToken}}

### b. Coba akses route protected setelah logout 
# → 401, karena token sudah di-revoke
GET {{baseUrl}}/me
Authorization: Bearer {{adminToken}}